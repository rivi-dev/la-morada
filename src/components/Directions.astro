---
import { Picture } from "astro:assets";
import { directionCards } from "../data/directions";
---

<section
  id="el-lugar"
  class="mx-auto max-w-6xl px-4 py-16 border-t border-canvas/10"
>
  <p class="font-mono text-xs uppercase tracking-[0.3em] text-canvas">
    El lugar
  </p>
  <h2 class="mt-3 text-3xl text-canvas font-display md:text-4xl">
    Cómo llegar
  </h2>

  <div class="grid grid-cols-1 mt-10 gap-x-8 gap-y-10 lg:grid-cols-4">
    {
      directionCards.map((card) => (
        <div class="flex flex-col items-center gap-3">
          <a
            href={card.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="block overflow-hidden rounded-2xl shadow-lg/40 shadow-canvas"
          >
            <Picture
              src={card.image}
              alt={card.alt}
              formats={["avif", "webp"]}
              quality={50}
              class="aspect-square w-full max-w-75 object-cover"
            />
          </a>

          <ul class="list-disc space-y-1 pt-10 px-6 text-base text-mist self-start">
            {card.bullets.map((bullet) => (
              <li class="mb-4" set:html={bullet} />
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
